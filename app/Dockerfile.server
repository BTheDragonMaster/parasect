# Use Mambaforge for fast, reliable conda solves (includes mamba)
FROM condaforge/mambaforge:24.9.2-0

# Make non-interactive shells load conda env nicely
SHELL ["/bin/bash", "-lc"]

# Create a non-root user for saner file permissions
ARG USERNAME=app
ARG USER_UID=1000
ARG USER_GID=$USER_UID
RUN groupadd --gid $USER_GID $USERNAME \
 && useradd  --uid $USER_UID --gid $USER_GID -m $USERNAME

# Workdir
WORKDIR /app

# Build context is the repo root (see docker-compose.yml), not app/, so this
# Dockerfile can also see src/parasect/ below. Everything here is app/-relative!

# Copy env first to leverage Docker layer caching
COPY app/server-environment.yml /app/
COPY app/server-requirements.txt /app/

# Create Conda env with mamba (faster) and clean caches
RUN mamba env create -n web -f server-environment.yml \
 && conda clean -afy

# Ensure `conda run -n web ...` works for ENTRYPOINT/CMD
RUN echo "conda activate web" >> /etc/bash.bashrc

# Install the local checkout of the core parasect/paras package
COPY pyproject.toml setup.cfg manifest.in /tmp/parasect-src/
COPY src/ /tmp/parasect-src/src/
RUN conda run -n web pip install --no-cache-dir /tmp/parasect-src \
 && rm -rf /tmp/parasect-src

# Copy the app code and give ownership to the non-root user
COPY --chown=${USER_UID}:${USER_GID} app/src/server/ /app/

# Ensure temp dir exists and is writable
RUN mkdir -p /app/temp && chown -R ${USER_UID}:${USER_GID} /app

# Runtime env: unbuffered logs, mmap for joblib, cap math threads
ENV PYTHONUNBUFFERED=1 \
    LOG_LEVEL=INFO \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1 \
    JOBLIB_MMAP_MODE=r \
    GUNICORN_WORKERS=1 \
    GUNICORN_THREADS=4

# Use the unprivileged user at runtime
USER $USERNAME

# Expose your service port
EXPOSE 4009

# Shell form (not exec-array) so $GUNICORN_WORKERS/$GUNICORN_THREADS are
# expanded at container start: lets docker-compose/orchestrator override
# worker count per-deployment without rebuilding the image. Job state lives
# in Redis (see routes/job_store.py), so GUNICORN_WORKERS can safely be > 1.
ENTRYPOINT ["/bin/bash", "-lc"]
CMD ["exec conda run --no-capture-output -n web gunicorn -b :4009 --worker-class gthread --workers ${GUNICORN_WORKERS} --threads ${GUNICORN_THREADS} --preload --timeout 120 api:app"]
