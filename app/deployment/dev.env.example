# Copy to app/.env.dev on the deployment server. Do not commit real secrets.
# The helper sets the project name, image tag and model directory itself.
PARAS_BIND_ADDRESS=127.0.0.1
PARAS_CLIENT_PORT=4011
GUNICORN_WORKERS=1
GUNICORN_THREADS=4

# These values are saved with a dev release and reused during promotion.
ZENODO_RECORD=18682178
PARAS_MODELS=all

# Use the SAME public site key in both environments; allow both hostnames
# in that Turnstile widget so the frontend image can be promoted unchanged.
REACT_APP_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Leave blank to prevent dev annotations from opening real GitHub issues.
GITHUB_TOKEN=
