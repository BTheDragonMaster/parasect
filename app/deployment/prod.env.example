# Copy to app/.env.prod on the deployment server. Do not commit real secrets.
PARAS_BIND_ADDRESS=127.0.0.1
PARAS_CLIENT_PORT=4010
GUNICORN_WORKERS=2
GUNICORN_THREADS=4

# Must match the public site key built into the tested dev release.
REACT_APP_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
GITHUB_TOKEN=
